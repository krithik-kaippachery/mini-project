<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dreamspace | Sign In</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="auth-page">
        <div class="auth-sidebar"></div>
        <div class="auth-content fade-up">
            <div style="text-align:center; margin-bottom:48px;">
                <div class="auth-brand-logo">DREAMSPACE</div>
                <p style="color:var(--text-secondary); font-size:1.1rem;">Welcome back to your studio.</p>
            </div>

            <div id="alert-box" style="padding:16px; border-radius:8px; margin-bottom:24px; display:none; background:var(--primary-subtle); color:var(--primary-dark); font-weight:500;"></div>

            <form id="login-form">
                <div class="form-group">
                    <label class="form-label" for="email">Email Address</label>
                    <input type="email" id="email" class="form-input" placeholder="admin@dreamspace.com" value="admin@dreamspace.com" required>
                </div>
                <div class="form-group">
                    <label class="form-label" for="password">Password</label>
                    <input type="password" id="password" class="form-input" placeholder="••••••••" value="password123" required>
                </div>
                <button type="submit" id="login-btn" class="btn btn-primary btn-full">Sign In</button>
            </form>

            <div class="auth-footer">
                Don't have an account? <a href="/register">Create one</a>
            </div>
        </div>
    </div>

    <script>
        const form = document.getElementById('login-form');
        const btn = document.getElementById('login-btn');
        const alertBox = document.getElementById('alert-box');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('password').value;

            if (!email || !password) {
                alertBox.style.display = 'block';
                alertBox.style.background = 'var(--primary-subtle)';
                alertBox.style.color = 'var(--primary-dark)';
                alertBox.textContent = 'Please enter both email and password.';
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Signing in...';

            try {
                const res = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password }),
                });
                const data = await res.json();

                if (data.success) {
                    alertBox.style.display = 'block';
                    alertBox.style.background = 'var(--success-subtle)';
                    alertBox.style.color = 'var(--success)';
                    alertBox.textContent = 'Login successful! Redirecting...';
                    setTimeout(() => window.location.href = data.redirectTo, 1000);
                } else {
                    alertBox.style.display = 'block';
                    alertBox.textContent = data.message || 'Login failed.';
                    btn.disabled = false;
                    btn.textContent = 'Sign In';
                }
            } catch (err) {
                alertBox.style.display = 'block';
                alertBox.textContent = 'Network error.';
                btn.disabled = false;
                btn.textContent = 'Sign In';
            }
        });
    </script>
</body>
</html>
