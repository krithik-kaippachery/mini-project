<%# views/partials/sidebar.ejs — Reusable sidebar included in all protected pages %>
<aside class="sidebar">
    <div class="sidebar-logo">
        <span class="sidebar-logo-icon">🏠</span>
        <span class="sidebar-logo-text">DREAMSPACE</span>
    </div>

    <nav class="sidebar-nav">
        <a href="/dashboard" class="sidebar-link <%= page === 'dashboard' ? 'active' : '' %>" id="nav-dashboard">
            <span class="sidebar-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            </span>
            <span class="sidebar-label">Dashboard</span>
        </a>
        <a href="/services" class="sidebar-link <%= page === 'services' ? 'active' : '' %>" id="nav-estimator">
            <span class="sidebar-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
            </span>
            <span class="sidebar-label">Estimator</span>
        </a>
        <a href="/about" class="sidebar-link <%= page === 'about' ? 'active' : '' %>" id="nav-portfolio">
            <span class="sidebar-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            </span>
            <span class="sidebar-label">Portfolio</span>
        </a>
    </nav>

    <div class="sidebar-bottom">
        <div class="sidebar-user-card">
            <div class="sidebar-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
            <div class="sidebar-user-info">
                <span class="sidebar-user-name"><%= user.name %></span>
                <span class="sidebar-user-plan plan-<%= user.plan.toLowerCase() %>"><%= user.plan %> Plan</span>
            </div>
        </div>
        <form action="/logout" method="POST" style="margin-top:12px;">
            <button type="submit" class="logout-btn" id="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                Logout
            </button>
        </form>
    </div>
</aside>
